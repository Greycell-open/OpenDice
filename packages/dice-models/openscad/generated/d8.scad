size_scale     = 1.0;    // 1.0 = standard size (d20 about 20 mm, d6 about 16 mm); 1.25 is 25 percent larger
engrave_depth  = 0.6;    // mm into each face
font           = "Liberation Sans:style=Bold";
text_scale     = 1.0;    // grow or shrink every number
mark_six_nine  = true;  // a dot after 6 and 9 so they can be told apart

points = [[-0.2717,-11.9966,0.2717],[0.2717,-0.2717,11.9966],[-0.2717,-0.2717,11.9966],[-0.2717,0.2717,11.9966],[11.9966,-0.2717,0.2717],[11.9966,0.2717,0.2717],[11.9966,0.2717,-0.2717],[-0.2717,11.9966,-0.2717],[-11.9966,0.2717,-0.2717],[-0.2717,11.9966,0.2717],[-11.9966,-0.2717,0.2717],[0.2717,-11.9966,0.2717],[0.2717,-11.9966,-0.2717],[0.2717,11.9966,0.2717],[0.2717,0.2717,11.9966],[0.2717,-0.2717,-11.9966],[-0.2717,-0.2717,-11.9966],[0.2717,0.2717,-11.9966],[-0.2717,0.2717,-11.9966],[-0.2717,-11.9966,-0.2717],[11.9966,-0.2717,-0.2717],[-11.9966,-0.2717,-0.2717],[-11.9966,0.2717,0.2717],[0.2717,11.9966,-0.2717]];
// Counter-clockwise from outside in the source; OpenSCAD wants clockwise.
faces = [[0,2,1],[3,1,2],[4,1,5],[6,4,5],[7,9,8],[10,2,0],[10,3,2],[11,0,1],[11,12,0],[11,4,12],[11,1,4],[13,3,9],[13,6,5],[13,9,7],[14,13,5],[14,3,13],[14,1,3],[14,5,1],[15,16,12],[15,17,16],[15,6,17],[18,16,17],[18,8,16],[18,7,8],[18,17,7],[19,10,0],[19,12,16],[19,0,12],[20,15,12],[20,6,15],[20,4,6],[20,12,4],[21,19,16],[21,10,19],[21,8,10],[21,16,8],[22,10,8],[22,3,10],[22,9,3],[22,8,9],[23,13,7],[23,6,13],[23,17,6],[23,7,17]];

// [number, text height in mm, placement on the face]
labels = [
