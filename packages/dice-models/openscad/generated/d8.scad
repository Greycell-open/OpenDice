  [2, 5.8873, [[0.7071,-0.4082,0.5774,4.18],[0.7071,0.4082,-0.5774,-4.18],[0,0.8165,0.5774,4.18],[0,0,0,1]]],
  [3, 5.8873, [[0.7071,-0.4082,0.5774,4.18],[0,-0.8165,-0.5774,-4.18],[0.7071,0.4082,-0.5774,-4.18],[0,0,0,1]]],
  [4, 5.8873, [[0.7071,-0.4082,0.5774,4.18],[-0.7071,-0.4082,0.5774,4.18],[0,-0.8165,-0.5774,-4.18],[0,0,0,1]]],
  [7, 5.8873, [[-0.7071,0.4082,-0.5774,-4.18],[0,0.8165,0.5774,4.18],[0.7071,0.4082,-0.5774,-4.18],[0,0,0,1]]],
  [8, 5.8873, [[-0.7071,0.4082,-0.5774,-4.18],[0.7071,0.4082,-0.5774,-4.18],[0,-0.8165,-0.5774,-4.18],[0,0,0,1]]],
