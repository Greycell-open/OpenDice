// Open Dice d4, generated by scripts/export-models.mjs from the same
// geometry the web roller draws. By Zein Alaouie, CC BY 4.0: credit
// "Dice model by Zein Alaouie (Open Dice), CC BY 4.0" when you share this
// model, a remix or prints. https://github.com/Greycell-open/OpenDice
// Edit the parameters, then
// Render (F6) and Export as STL. Regenerate with: npm run models
//
// Opposite faces sum to n/a (a d4 is read at its top point).

size_scale     = 1.0;    // 1.0 = standard size (d20 about 20 mm, d6 about 16 mm); 1.25 is 25 percent larger
engrave_depth  = 0.6;    // mm into each face
font           = "Liberation Sans:style=Bold";
text_scale     = 1.0;    // grow or shrink every number
mark_six_nine  = false;  // a dot after 6 and 9 so they can be told apart

points = [[6.6125,6.9262,6.9262],[6.9262,6.9262,6.6125],[-6.9262,6.9262,-6.6125],[-6.6125,6.9262,-6.9262],[6.9262,-6.9262,-6.6125],[-6.6125,-6.9262,6.9262],[6.6125,-6.9262,-6.9262],[-6.9262,-6.9262,6.6125],[-6.9262,-6.6125,6.9262],[6.9262,-6.6125,-6.9262],[6.9262,6.6125,6.9262],[-6.9262,6.6125,-6.9262]];
// Counter-clockwise from outside in the source; OpenSCAD wants clockwise.
faces = [[0,2,1],[3,1,2],[4,6,5],[7,5,6],[8,0,5],[8,2,0],[8,7,2],[8,5,7],[9,3,6],[9,1,3],[9,4,1],[9,6,4],[10,4,5],[10,1,4],[10,0,1],[10,5,0],[11,7,6],[11,2,7],[11,3,2],[11,6,3]];

// [number, text height in mm, placement on the face]
labels = [
  [1, 4.138, [[0,0.8165,-0.5774,2.4133],[-0.7071,0.4082,0.5774,4.8266],[0.7071,0.4082,0.5774,4.8266],[0,0,0,1]]],
  [2, 4.138, [[0.7071,-0.4082,-0.5774,-4.8266],[0.7071,0.4082,0.5774,4.8266],[0,-0.8165,0.5774,-2.4133],[0,0,0,1]]],
  [3, 4.138, [[-0.7071,-0.4082,-0.5774,-4.8266],[0,-0.8165,0.5774,-2.4133],[-0.7071,0.4082,0.5774,4.8266],[0,0,0,1]]],
  [2, 4.138, [[0,-0.8165,0.5774,-2.4133],[-0.7071,0.4082,0.5774,4.8266],[-0.7071,-0.4082,-0.5774,-4.8266],[0,0,0,1]]],
  [1, 4.138, [[-0.7071,0.4082,0.5774,4.8266],[0.7071,0.4082,0.5774,4.8266],[0,0.8165,-0.5774,2.4133],[0,0,0,1]]],
  [4, 4.138, [[0.7071,0.4082,0.5774,4.8266],[0,-0.8165,0.5774,-2.4133],[0.7071,-0.4082,-0.5774,-4.8266],[0,0,0,1]]],
  [1, 4.138, [[0.7071,0.4082,0.5774,4.8266],[0,0.8165,-0.5774,2.4133],[-0.7071,0.4082,0.5774,4.8266],[0,0,0,1]]],
  [3, 4.138, [[0,-0.8165,0.5774,-2.4133],[0.7071,-0.4082,-0.5774,-4.8266],[0.7071,0.4082,0.5774,4.8266],[0,0,0,1]]],
  [4, 4.138, [[-0.7071,0.4082,0.5774,4.8266],[-0.7071,-0.4082,-0.5774,-4.8266],[0,-0.8165,0.5774,-2.4133],[0,0,0,1]]],
  [3, 4.138, [[0.7071,-0.4082,-0.5774,-4.8266],[-0.7071,-0.4082,-0.5774,-4.8266],[0,0.8165,-0.5774,2.4133],[0,0,0,1]]],
  [2, 4.138, [[-0.7071,-0.4082,-0.5774,-4.8266],[0,0.8165,-0.5774,2.4133],[0.7071,-0.4082,-0.5774,-4.8266],[0,0,0,1]]],
  [4, 4.138, [[0,0.8165,-0.5774,2.4133],[0.7071,-0.4082,-0.5774,-4.8266],[-0.7071,-0.4082,-0.5774,-4.8266],[0,0,0,1]]]
];

function label_text(n) = (mark_six_nine && (n == 6 || n == 9)) ? str(n, ".") : str(n);

scale(size_scale) difference() {
  polyhedron(points = points, faces = faces, convexity = 2);
  for (l = labels)
    multmatrix(l[2])
      translate([0, 0, -engrave_depth / size_scale])
        linear_extrude(engrave_depth / size_scale + 0.05)
          text(label_text(l[0]), size = l[1] * 0.62 * text_scale, font = font,
               halign = "center", valign = "center");
}
